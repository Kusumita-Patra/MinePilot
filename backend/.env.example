# Supabase Postgres connection string (transaction pooler, port 6543)
DATABASE_URL=postgresql+asyncpg://user:password@host:6543/postgres

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Upstream T2 ML/telemetry simulator (do not modify inference_api.py, only consume it)
ML_SERVICE_WS_URL=ws://localhost:8000/ws/telemetry
ML_SERVICE_REST_URL=http://localhost:8000

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# This backend's own port (frontend's NEXT_PUBLIC_API_URL / NEXT_PUBLIC_WS_URL should point here)
PORT=8001
